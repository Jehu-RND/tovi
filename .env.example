# Copy to .env and fill in. Never commit .env.

# Figma personal access token.
# Create one at: Figma -> Settings -> Security -> Personal access tokens
FIGMA_TOKEN=

# Figma file key — the segment after /design/ or /file/ in the file URL:
# https://www.figma.com/design/<FIGMA_FILE_KEY>/My-Design
# Optional: the config file's `figmaFileKey` takes precedence when set.
FIGMA_FILE_KEY=
