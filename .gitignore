node_modules/

# Secrets
.env
.env.local

# Local config — may contain client URLs. Commit the example instead.
tovi.config.json
.claude/settings.local.json

# Build output
dist/

# Screenshots and generated reports
*.png
out/
reports/

# ...but test fixtures are source, not output. The lazy-image integration suite
# needs a real image file on disk: a data: URI is not deferred the way a fetched
# one is, so the trap it exercises would not happen.
!tests/fixtures/*.png

# Test + tooling caches
coverage/
.vitest/
*.tsbuildinfo

# OS / editor
.DS_Store
